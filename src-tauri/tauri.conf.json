{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Songscription",
  "version": "0.1.0",
  "identifier": "com.songscription.catalogue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Songscription — 我的琴谱册",
        "width": 1320,
        "height": 880,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "把扒下来的谱子收成一册",
    "longDescription": "一份「已经扒下来的谱子」的目录册。每一首都从它自己的 MIDI 文件里量出来：弹完要多久、有多难、用到哪些键、该从哪儿开始练。就着窗口就能听，也能排成五线谱印出来。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Songscription",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
