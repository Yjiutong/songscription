{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Songscription",
  "version": "0.1.0",
  "identifier": "com.songscription.catalogue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Songscription",
        "width": 1320,
        "height": 880,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Your transcribed songs, measured",
    "longDescription": "A catalogue for the songs you have had transcribed. Each one is measured from its own MIDI file: how long it takes, how hard it is, which keys it uses, and how to start learning it. Plays in the window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
